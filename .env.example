# =============================================================================
# Variáveis de ambiente da Editora Livrin
# Copie para ".env" e ajuste:   cp .env.example .env
# Todas as variáveis estão documentadas em docs/environment.md.
# NUNCA versione o arquivo .env com senhas reais.
# =============================================================================

# --- Banco de dados (PostgreSQL) ---------------------------------------------
POSTGRES_DB=livrin_db
POSTGRES_USER=livrin_user
# Obrigatória. Troque por uma senha forte.
POSTGRES_PASSWORD=12345678

# --- API ---------------------------------------------------------------------
# Obrigatória. Segredo para assinar os tokens JWT (mínimo 32 caracteres aleatórios).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1d
# Origens autorizadas (CORS), separadas por vírgula. Com o Nginx/Vite fazendo proxy, a origem é a do próprio site.
CORS_ORIGINS=http://localhost:5173
# Tamanho máximo de upload das obras, em MB.
MAX_UPLOAD_MB=180

# --- Administrador inicial (criado pelo seed se ainda não existir) ------------
ADMIN_NAME=Administrador Livrin
ADMIN_EMAIL=admin@livrin.local
# Mínimo 8 caracteres. Troque após o primeiro acesso.
ADMIN_PASSWORD=12345678

# --- Dados de demonstração ---------------------------------------------------
# true = cria obras, autores, leitores, avaliações e métricas de exemplo (como no protótipo).
SEED_DEMO_DATA=true
# Senha de TODAS as contas de demonstração (ex.: marina@livrin.com). Mínimo 8 caracteres.
DEMO_USER_PASSWORD=Demo12345

# --- Portas expostas no computador -------------------------------------------
WEB_PORT=5173
API_PORT=3000
# Usada apenas no docker-compose.dev.yml
DB_PORT=5432
