# =============================================================================
# Editora Livrin — variáveis de ambiente (Docker)
#
# Copie este arquivo para ".env" e ajuste o que precisar:
#     Linux/macOS   cp .env.example .env
#     Windows       Copy-Item .env.example .env
#
# Mais simples ainda: rode "iniciar.bat" (Windows) ou "./iniciar.sh" (Linux/macOS).
# Eles criam o .env sozinhos e geram um JWT_SECRET aleatório na primeira execução.
#
# NUNCA versione o arquivo .env preenchido. Ele está no .gitignore.
# Todas as variáveis estão documentadas em docs/environment.md.
# =============================================================================

# -----------------------------------------------------------------------------
# SEGREDO DE ASSINATURA DOS TOKENS — obrigatório, sem valor padrão
# -----------------------------------------------------------------------------
# Deixe vazio aqui. Os scripts de inicialização geram um valor aleatório.
# Para gerar manualmente:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A API recusa segredos de exemplo, marcadores ("troque-por...") e valores com
# pouca variedade de caracteres — ver api/src/config/env.ts.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# =============================================================================
# CREDENCIAIS DE DESENVOLVIMENTO
# -----------------------------------------------------------------------------
# Os três valores abaixo existem para que o projeto suba e possa ser avaliado
# imediatamente após a instalação, como permite a seção 6 da especificação.
# São credenciais de DESENVOLVIMENTO e estão aqui de propósito.
# EM PRODUÇÃO, TROQUE AS TRÊS. Ver docs/deployment.md.
# =============================================================================

# --- Banco de dados (PostgreSQL) ---------------------------------------------
POSTGRES_DB=livrin_db
POSTGRES_USER=livrin_user
# Credencial de desenvolvimento. O PostgreSQL só aplica esta senha ao CRIAR o
# volume: se você já rodou o projeto antes com outra senha, mantenha a antiga
# aqui ou recrie o banco com "docker compose down -v" (isso apaga os dados).
POSTGRES_PASSWORD=livrin_dev_2026

# --- Administrador inicial (criado pelo seed se o e-mail ainda não existir) ---
ADMIN_NAME=Administrador Livrin
ADMIN_EMAIL=admin@livrin.local
# Credencial de desenvolvimento. Mínimo de 8 caracteres, com letras e números.
ADMIN_PASSWORD=Livrin.Dev2026

# --- Dados de demonstração ---------------------------------------------------
# true = cria obras, autores, leitores, avaliações e métricas de exemplo.
SEED_DEMO_DATA=true
# Credencial de desenvolvimento, válida para TODAS as contas de demonstração
# (marina@livrin.com, lucas@livrin.com, ...). Mínimo de 8 caracteres.
DEMO_USER_PASSWORD=Demo.Livrin2026

# =============================================================================
# Configuração da aplicação (pode ficar como está)
# =============================================================================

# Origens autorizadas (CORS), separadas por vírgula. Com o Nginx/Vite fazendo
# proxy, a origem é a do próprio site e esta lista quase nunca entra em ação.
CORS_ORIGINS=http://localhost:5173
# Tamanho máximo de upload das obras, em MB.
MAX_UPLOAD_MB=180

# --- Portas expostas no computador -------------------------------------------
WEB_PORT=5173
API_PORT=3000
# Usada apenas no docker-compose.dev.yml
DB_PORT=5432
