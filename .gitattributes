# Normaliza finais de linha (evita problemas entre Windows, Linux e macOS)
* text=auto eol=lf
*.png binary
*.jpg binary
*.webp binary
*.pdf binary
*.cbz binary
*.cbr binary
*.epub binary
*.docx binary
*.mp3 binary
*.ogg binary
*.m4a binary

# Scripts do Windows precisam de CRLF para o cmd.exe
*.bat text eol=crlf
*.sh text eol=lf
