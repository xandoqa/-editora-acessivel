# =============================================================================
# Variáveis para rodar a API FORA do Docker (cd api && npm run dev).
# Copie para "api/.env":  cp .env.example .env
#
# Com Docker, este arquivo é ignorado: vale o .env da raiz do projeto.
# Detalhes em docs/environment.md.
# =============================================================================
NODE_ENV=development
PORT=3000

# Aponte para um PostgreSQL acessível a partir da sua máquina. Se você subiu
# apenas o banco com "docker compose up db", use a senha do .env da raiz.
DATABASE_URL=postgres://livrin_user:livrin_dev_2026@localhost:5432/livrin_db

# -----------------------------------------------------------------------------
# Obrigatório, sem valor padrão. Gere o seu:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A API recusa segredos de exemplo e marcadores — ver src/config/env.ts.
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=1d

CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=180

# Qual implementação de PaymentProvider a API usa. Há duas: "simulado", que não
# movimenta dinheiro nenhum, e "abacatepay", que abre cobrança PIX de verdade.
# Valor desconhecido — ou "abacatepay" sem chave — cai no simulado, com aviso no
# log. Ver docs/pagamento-real-opcoes.md e docs/decisions/023-abacatepay.md.
PAYMENT_PROVIDER=simulado

# AbacatePay (PIX). A chave sai do painel deles e NÃO vai neste arquivo, que é
# versionado — ela mora no .env. ABACATEPAY_DEV_MODE declara o ambiente da
# chave; cada cobrança volta dizendo em que ambiente nasceu, e a API confere um
# contra o outro. Deixe true até querer movimentar dinheiro de verdade.
ABACATEPAY_API_KEY=
ABACATEPAY_DEV_MODE=true
TRUST_PROXY=false
BCRYPT_ROUNDS=10
LOG_REQUESTS=true

# --- Credenciais de DESENVOLVIMENTO (ver seção 6 da especificação) -----------
ADMIN_NAME=Administrador Livrin
ADMIN_EMAIL=admin@livrin.local
ADMIN_PASSWORD=Livrin.Dev2026
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=Demo.Livrin2026

# --- Fale Conosco ------------------------------------------------------------
# O formulário de contato funciona SEM NADA DISTO configurado: a mensagem é
# gravada no banco e aparece em Administração → Fale Conosco. É o modo da
# apresentação sem internet, e nada se perde nele.
#
# O que as variáveis abaixo acrescentam é a segunda etapa: o e-mail saindo para
# uma caixa de verdade. Preencha as cinco e reinicie a API.
#
# CONTATO_EMAIL_DESTINO é a caixa que recebe as mensagens. Deixei em branco de
# propósito: endereço de e-mail pessoal em repositório público é varrido por
# robô de spam em poucos dias. Escreva o seu aqui, no .env, que não é
# versionado.
CONTATO_EMAIL_DESTINO=
#
# SMTP_PASS é SENHA DE APP, nunca a senha da conta. No Gmail ela é gerada em
# Conta Google -> Seguranca -> Senhas de app, e exige verificacao em duas
# etapas ligada. Uma senha de app pode ser revogada sozinha, sem mexer na conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Livrin - Fale Conosco

# --- Testes automatizados ----------------------------------------------------
# Banco usado por "npm test". Ele é APAGADO a cada execução e o nome precisa
# conter "test". Use as credenciais do seu PostgreSQL local.
TEST_DATABASE_URL=postgres://livrin_user:livrin_dev_2026@localhost:5432/livrin_test
