# Variáveis para rodar a API FORA do Docker (npm run dev). Copie para api/.env.
# Com Docker, use o .env da raiz do projeto. Detalhes em docs/environment.md.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://livrin_user:troque-esta-senha-do-banco@localhost:5432/livrin_db
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1d
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=180
TRUST_PROXY=false
BCRYPT_ROUNDS=10
ADMIN_NAME=Administrador Livrin
ADMIN_EMAIL=admin@livrin.local
ADMIN_PASSWORD=TroqueEstaSenha123
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=Demo12345
LOG_REQUESTS=true
# Banco usado pelos testes automatizados (será APAGADO a cada execução)
TEST_DATABASE_URL=postgres://livrin_user:troque-esta-senha-do-banco@localhost:5432/livrin_test
