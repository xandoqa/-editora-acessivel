# =============================================================================
# Variáveis para rodar a API FORA do Docker (cd api && npm run dev).
# Copie para "api/.env":  cp .env.example .env
#
# Com Docker, este arquivo é ignorado: vale o .env da raiz do projeto.
# Detalhes em docs/environment.md.
# =============================================================================
NODE_ENV=development
PORT=3000

# Aponte para um PostgreSQL acessível a partir da sua máquina. Se você subiu
# apenas o banco com "docker compose up db", use a senha do .env da raiz.
DATABASE_URL=postgres://livrin_user:livrin_dev_2026@localhost:5432/livrin_db

# -----------------------------------------------------------------------------
# Obrigatório, sem valor padrão. Gere o seu:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A API recusa segredos de exemplo e marcadores — ver src/config/env.ts.
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=1d

CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=180
TRUST_PROXY=false
BCRYPT_ROUNDS=10
LOG_REQUESTS=true

# --- Credenciais de DESENVOLVIMENTO (ver seção 6 da especificação) -----------
ADMIN_NAME=Administrador Livrin
ADMIN_EMAIL=admin@livrin.local
ADMIN_PASSWORD=Livrin.Dev2026
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=Demo.Livrin2026

# --- Testes automatizados ----------------------------------------------------
# Banco usado por "npm test". Ele é APAGADO a cada execução e o nome precisa
# conter "test". Use as credenciais do seu PostgreSQL local.
TEST_DATABASE_URL=postgres://livrin_user:livrin_dev_2026@localhost:5432/livrin_test
