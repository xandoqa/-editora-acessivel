# Variáveis do front-end (opcionais). Copie para web/.env se precisar alterar.
# Para onde o servidor de desenvolvimento do Vite encaminha /api e /uploads.
API_PROXY_TARGET=http://localhost:3000
# Limite exibido/validado no formulário de upload (deve igualar MAX_UPLOAD_MB da API).
VITE_MAX_UPLOAD_MB=180
# Opcional: URL absoluta da API (por padrão usa o caminho relativo /api).
# VITE_API_URL=https://api.exemplo.com/api
